# Copy to .env and fill in the two required values. Never commit .env.
#
# API_ID and API_HASH come from https://my.telegram.org -> API development tools.
# They identify the application, not your account - see the README section
# "About the credentials in .env" for what leaking them does and does not mean.

API_ID=
API_HASH=

# ---------------------------------------------------------------------------
# Everything below is optional. The values shown are the built-in defaults;
# uncomment a line only to change it.
# ---------------------------------------------------------------------------

# Session file name, without the .session suffix. Holds your login - treat it
# as a password, keep its permissions at 600, never copy it anywhere shared.
#SESSION_NAME=userbot

# Prefix that marks a message as a command.
#PREFIX=.

# SQLite database for notes and key/value state.
#DB_PATH=userbot.db

# .bulk pacing. Anything below 10s risks PeerFloodError and, on repeat,
# restrictions on the account. BULK_CAP is the ceiling per run.
#BULK_MIN_DELAY=15
#BULK_MAX_DELAY=40
#BULK_CAP=50

# Notification queue: the directory notify_client.py writes into, how often the
# userbot polls it, and the randomised gap between two deliveries.
#NOTIFY_SPOOL_DIR=notify_spool
#NOTIFY_POLL_INTERVAL=5
#NOTIFY_MIN_DELAY=2
#NOTIFY_MAX_DELAY=6
